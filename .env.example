# Auth.js v5
AUTH_SECRET=                          # generate: openssl rand -base64 32
AUTH_GOOGLE_ID=                       # from Google Cloud Console OAuth 2.0 credentials
AUTH_GOOGLE_SECRET=                   # from Google Cloud Console OAuth 2.0 credentials

# Database (Neon PostgreSQL)
DATABASE_URL=                         # postgresql://user:pass@host/db?sslmode=require

# Upstash Redis
UPSTASH_REDIS_REST_URL=               # from Upstash console
UPSTASH_REDIS_REST_TOKEN=             # from Upstash console

# YouTube Data API v3
YOUTUBE_API_KEY=                      # from Google Cloud Console

# Anthropic Claude API
ANTHROPIC_API_KEY=                    # from console.anthropic.com

# Stripe
STRIPE_SECRET_KEY=                    # from Stripe dashboard (sk_live_... or sk_test_...)
STRIPE_WEBHOOK_SECRET=                # from Stripe webhook settings (whsec_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=   # from Stripe dashboard (pk_live_... or pk_test_...)

# App
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NODE_ENV=development
